# Silicon Patterns Platform — environment configuration.
# Copy to `.env` and fill in. NEVER commit real values.
#
# NOTE: do NOT put inline `# comments` on a value line — the settings loader keeps
# them as part of the value (e.g. a non-empty SP_API_KEY would silently enable auth).
# Leave a key commented out / empty to use its local default.

# ─────────────────────────────────────────────────────────────────────────────
# 1. MASTER DATABASE — the platform's own dedicated PostgreSQL.
#    Used by the backend API, orchestrator, ingestors, and lead scoring.
#    Leave unset locally to fall back to the SQLite file `master_local.db`.
#    Use the DIRECT connection (port 5432), not a transaction pooler, for migrations.
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/silicon_patterns

# ─────────────────────────────────────────────────────────────────────────────
# 2. BACKEND API
#    Set SP_API_KEY to require the X-API-Key header on all data endpoints (prod).
#    Leave it unset/commented locally for dev-open auth.
# ─────────────────────────────────────────────────────────────────────────────
# SP_API_KEY=your-prod-api-key
# CORS_ORIGINS=["https://your-frontend.example"]

# ─────────────────────────────────────────────────────────────────────────────
# 3. DECISION MAKER INTELLIGENCE ENGINE (Apify) — the decision-maker source.
#    The `decision_maker_intelligence` stage calls this Apify actor over its API.
#    Without APIFY_API_TOKEN the stage is skipped (the rest of the pipeline runs).
# ─────────────────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=
# APIFY_ACTOR_ID=T1XDXWc1L92AfIJtd   # optional override; defaults to this actor

# ─────────────────────────────────────────────────────────────────────────────
# 4. LEGACY — LinkedIn Scraper Supabase source (NO LONGER used by the pipeline).
#    Decision makers now come from the Apify engine above. These vars are only for
#    the legacy supabase_source adapter, kept for backward compatibility.
# ─────────────────────────────────────────────────────────────────────────────
# SP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SP_SUPABASE_SERVICE_KEY=
# SP_SUPABASE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 5. AUTHENTICATION — Microsoft Entra ID (Azure AD) sign-in (see
#    backend/security.py::verify_microsoft_id_token + backend/services.py::login_with_microsoft).
#    ENVIRONMENT=production hard-disables the dev bypass (see backend/security.py
#    _bypass_on) and refuses to start at all unless SP_JWT_SECRET is strong (32+
#    chars) AND MICROSOFT_TENANT_ID/MICROSOFT_CLIENT_ID are set — there is no
#    implicit open-API fallback, and no other sign-in path in production.
# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT=production
# SP_JWT_SECRET=                    # signs this app's OWN session JWTs; 32+ random chars
# SP_ADMIN_EMAILS=you@siliconpatterns.com   # comma-separated; auto-approved as admin
#                                    # on first Microsoft sign-in
#
# Initial administrator bootstrap: this email is auto-provisioned active
# super_admin (skipping the pending queue) the first time it signs in via
# Microsoft — see backend/services.py::login_with_microsoft. Once that account
# exists, later sign-ins never touch its role again.
# SP_BOOTSTRAP_ADMIN_EMAIL=admin@siliconpatterns.com
#
# Microsoft Entra App Registration (Single-Page Application platform,
# Authorization Code + PKCE). NEVER commit real values — this file is the
# *example*; set them only in your own local/deploy .env. The client secret is
# accepted for completeness but isn't required by the current sign-in flow (ID
# tokens are verified locally against the tenant's JWKS, not exchanged/introspected).
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# 6. STANDARD RUN SCHEDULER + OUTLOOK NOTIFICATIONS (all optional; sensible defaults)
#    The scheduler fires the full pipeline at each SP_SCHEDULE_TIMES slot. It runs
#    IN-PROCESS, so it needs an always-on instance — disable it (or run a dedicated
#    worker) on a sleeping/free host. Notifications e-mail every ACTIVE user after a
#    scheduled run via Microsoft Graph (reuses the Entra app); failures never fail
#    the pipeline. See backend/scheduler.py + backend/notifications.py.
# ─────────────────────────────────────────────────────────────────────────────
# SP_SCHEDULER_ENABLED=true            # default true; set false to disable scheduled runs
# SP_SCHEDULE_TIMES=09:00,21:00        # comma-separated HH:MM slots
# SP_SCHEDULE_GRACE_MINUTES=180        # how long after a slot a missed run may still fire
# SP_NOTIFY_MODE=auto                  # auto | graph | log | off
# SP_NOTIFY_SENDER_EMAIL=              # licensed mailbox Graph sends from (defaults to bootstrap admin)

# ─────────────────────────────────────────────────────────────────────────────
# 7. MACHINE LEARNING (optional; defaults work out of the box, no extra services)
#    Feature store + recommendation model. Embeddings use a deterministic zero-
#    dependency fallback by default; set the backend to sentence-transformers only
#    if you install it. None of this runs inside a scheduled pipeline. See ml/.
# ─────────────────────────────────────────────────────────────────────────────
# SP_ML_ENABLED=true
# SP_ML_EMBEDDING_BACKEND=hash         # hash (default) | sentence-transformers
# SP_ML_FEATURE_VERSION=fs-1
# SP_ML_PRIMARY_METRIC=pr_auc          # metric a promotion is judged on
# SP_ML_PROMOTE_MIN_ROC_AUC=0.60       # quality gates a candidate must clear to be promoted
# SP_ML_PROMOTE_MIN_PR_AUC=0.50
