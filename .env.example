# Silicon Patterns Platform — environment configuration.
# Copy to `.env` and fill in. NEVER commit real values.
#
# NOTE: do NOT put inline `# comments` on a value line — the settings loader keeps
# them as part of the value (e.g. a non-empty SP_API_KEY would silently enable auth).
# Leave a key commented out / empty to use its local default.

# ─────────────────────────────────────────────────────────────────────────────
# 1. MASTER DATABASE — the platform's own dedicated PostgreSQL.
#    Used by the backend API, orchestrator, ingestors, and lead scoring.
#    Leave unset locally to fall back to the SQLite file `master_local.db`.
#    Use the DIRECT connection (port 5432), not a transaction pooler, for migrations.
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/silicon_patterns
#
#    Pending migrations are applied AUTOMATICALLY before the API serves its first
#    request, so a deploy needs no manual migration step. Postgres only (local SQLite
#    builds its schema from the ORM). A failure ABORTS startup — the process must not
#    serve traffic on a schema it does not match. Concurrent replicas are serialized
#    by a Postgres advisory lock. Set false to go back to running
#    `python scripts/apply_migrations.py` out-of-band.
# AUTO_MIGRATE=true

# ─────────────────────────────────────────────────────────────────────────────
# 2. BACKEND API
#    Set SP_API_KEY to require the X-API-Key header on all data endpoints (prod).
#    Leave it unset/commented locally for dev-open auth.
# ─────────────────────────────────────────────────────────────────────────────
# SP_API_KEY=your-prod-api-key
# CORS_ORIGINS=["https://your-frontend.example"]

# ─────────────────────────────────────────────────────────────────────────────
# 3. DECISION MAKER INTELLIGENCE ENGINE (Apify) — the decision-maker source.
#    The `decision_maker_intelligence` stage calls this Apify actor over its API.
#    Without APIFY_API_TOKEN the stage is skipped (the rest of the pipeline runs).
# ─────────────────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=
# APIFY_ACTOR_ID=T1XDXWc1L92AfIJtd   # optional override; defaults to this actor

# ─────────────────────────────────────────────────────────────────────────────
# 4. LEGACY — LinkedIn Scraper Supabase source (NO LONGER used by the pipeline).
#    Decision makers now come from the Apify engine above. These vars are only for
#    the legacy supabase_source adapter, kept for backward compatibility.
# ─────────────────────────────────────────────────────────────────────────────
# SP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SP_SUPABASE_SERVICE_KEY=
# SP_SUPABASE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 5. AUTHENTICATION — Microsoft Entra ID (Azure AD) sign-in (see
#    backend/security.py::verify_microsoft_id_token + backend/services.py::login_with_microsoft).
#    ENVIRONMENT=production hard-disables the dev bypass (see backend/security.py
#    _bypass_on) and refuses to start at all unless SP_JWT_SECRET is strong (32+
#    chars) AND MICROSOFT_TENANT_ID/MICROSOFT_CLIENT_ID are set — there is no
#    implicit open-API fallback, and no other sign-in path in production.
# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT=production
# SP_JWT_SECRET=                    # signs this app's OWN session JWTs; 32+ random chars
# SP_ADMIN_EMAILS=you@siliconpatterns.com   # comma-separated; auto-approved as admin
#                                    # on first Microsoft sign-in
#
# Initial administrator bootstrap: this email is auto-provisioned active
# super_admin (skipping the pending queue) the first time it signs in via
# Microsoft — see backend/services.py::login_with_microsoft. Once that account
# exists, later sign-ins never touch its role again.
# SP_BOOTSTRAP_ADMIN_EMAIL=admin@siliconpatterns.com
#
# Microsoft Entra App Registration (Single-Page Application platform,
# Authorization Code + PKCE). NEVER commit real values — this file is the
# *example*; set them only in your own local/deploy .env. The client secret is
# accepted for completeness but isn't required by the current sign-in flow (ID
# tokens are verified locally against the tenant's JWKS, not exchanged/introspected).
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# 6. STANDARD RUN SCHEDULER + NOTIFICATION FRAMEWORK (optional; sensible defaults)
#    The scheduler fires the full pipeline at each SP_SCHEDULE_TIMES slot. It runs
#    IN-PROCESS, so it needs an always-on instance — disable it (or run a dedicated
#    worker) on a sleeping/free host.
#
#    After each SCHEDULED run the scheduler hands the result to the notification
#    service (backend/notifications/), which renders an HTML report and gives it to
#    the configured provider. Only APPROVED, ACTIVE users are notified; pending,
#    disabled, rejected and deleted accounts never are. A delivery failure is logged
#    to notification_deliveries and never fails the pipeline.
#
#    Only the email channel ships today (SMTP; Gmail defaults below). Teams/Slack/
#    webhook/in-app are added as providers without any scheduler change.
# ─────────────────────────────────────────────────────────────────────────────
# SP_SCHEDULER_ENABLED=true            # default true; set false to disable scheduled runs
# SP_SCHEDULE_TIMES=09:00,21:00        # comma-separated HH:MM slots (server-local)
# SP_SCHEDULE_GRACE_MINUTES=180        # how long after a slot a missed run may still fire

# --- notification framework ---------------------------------------------------
# ENABLE_NOTIFICATIONS=true            # master switch for every channel
# NOTIFICATION_PROVIDER=gmail          # registered provider: email | gmail
# NOTIFICATION_RETRY_COUNT=3           # total send attempts (1 = no retry)
# FRONTEND_URL=https://your-app.vercel.app   # "Open Silicon Patterns" button target
# BRAND_NAME=Silicon Patterns
# BRAND_LOGO_URL=                      # absolute URL; blank renders a built-in monogram

# --- email / SMTP sender identity ---------------------------------------------
# Gmail needs an APP PASSWORD (Google Account -> Security -> 2-Step Verification ->
# App passwords), NOT the account password. Any RFC-compliant SMTP server works by
# changing host/port. NEVER commit a real password — set it in the host's env vars.
# EMAIL_PROVIDER=gmail                 # alias for NOTIFICATION_PROVIDER
# EMAIL_FROM=you@gmail.com
# EMAIL_DISPLAY_NAME=Silicon Patterns
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=                       # 16-character Gmail app password
# SMTP_USE_STARTTLS=true               # port 587 (default)
# SMTP_USE_SSL=false                   # set true for implicit TLS on port 465

# --- legacy --------------------------------------------------------------------
# SP_NOTIFY_MODE was the pre-framework kill switch. Only 'off' still does anything,
# as a backward-compatible alias for ENABLE_NOTIFICATIONS=false.
# SP_NOTIFY_MODE=auto

# ─────────────────────────────────────────────────────────────────────────────
# 6a. WEB CRAWLING INFRASTRUCTURE (optional; a plain-HTTP provider works with no keys)
#    Shared retrieval used by Market Discovery, News Collection, Career Intelligence
#    and any future crawler. INFRASTRUCTURE ONLY — it fetches content and returns it;
#    every business decision belongs to the engine that asked for the crawl.
#
#    Firecrawl is ONE provider behind a vendor-neutral abstraction, not the
#    architecture. Leave CRAWL_PROVIDER empty to select by capability: a
#    JS-rendering provider when the caller needs one, otherwise the free plain-HTTP
#    provider. Swapping vendors is a settings change plus one new provider module.
# ─────────────────────────────────────────────────────────────────────────────
# CRAWL_PROVIDER=                      # ""=auto by capability | firecrawl | http
# CRAWL_FALLBACK_PROVIDER=http         # used when the preferred provider is unusable
# CRAWL_TIMEOUT=30                     # seconds per request
# CRAWL_CONCURRENCY=4                  # simultaneous requests, all hosts
# CRAWL_PER_HOST_CONCURRENCY=2         # simultaneous requests to ONE host
# CRAWL_RATE_LIMIT=60                  # requests/minute, all hosts (0 = unlimited)
# CRAWL_PER_HOST_RATE_LIMIT=30         # requests/minute to ONE host — politeness
# CRAWL_CACHE_TTL=3600                 # seconds; 0 disables caching entirely
# CRAWL_CACHE_MAX_ENTRIES=512
# CRAWL_MAX_DEPTH=1                    # recursive crawl depth
# CRAWL_MAX_PAGES=20                   # pages per crawl
# CRAWL_RETRY_COUNT=3                  # attempts (1 = no retry); permanent errors never retry
# CRAWL_RETRY_BACKOFF=1.0              # base seconds, exponential with full jitter
# CRAWL_RETRY_MAX_BACKOFF=30.0
# CRAWL_USER_AGENT=SiliconPatternsBot/1.0 (+https://siliconpatterns.com/bot; platform crawler)

# --- Firecrawl provider (one provider among several) --------------------------
# Without a key the platform silently uses the plain-HTTP provider, which cannot
# render JavaScript. NEVER commit a real key — set it in the host's env vars.
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev   # override for a self-hosted instance

# ─────────────────────────────────────────────────────────────────────────────
# 6b. MARKET DISCOVERY ENGINE (optional; safe no-op until a connector is enabled)
#    The engine owns ALL discovery business logic — normalization, validation,
#    duplicate detection, company resolution, confidence, events, persistence.
#    External services (Firecrawl, Wellfound, Dealroom, Crunchbase, conference
#    sites, VC portfolios, government registries) are DATA PROVIDERS ONLY: they
#    return candidates and never touch the database or implement a business rule.
#
#    It runs as the `market_discovery` stage of every scheduled Standard Run. With
#    no connector registered the run is a successful no-op, which is the state the
#    platform ships in — nothing here needs setting to deploy safely.
#
#    Enablement is EXPLICIT: a source must be registered AND named below before it
#    runs, because these providers cost money and have rate limits.
# ─────────────────────────────────────────────────────────────────────────────
# DISCOVERY_ENABLED=true               # master switch for the whole engine
# DISCOVERY_SOURCES=                   # comma-separated names, e.g. firecrawl,wellfound
#                                      # "*" enables every registered source (dev only)
# DISCOVERY_SOURCE_LIMIT=500           # max candidates accepted from ONE source per run (0 = unbounded)
# DISCOVERY_CONCURRENCY=4              # sources fetched in parallel (1 = strictly serial)
# DISCOVERY_RETRY_COUNT=2              # attempts per source per run (1 = no retry)
# DISCOVERY_RETRY_BACKOFF=2.0          # seconds between attempts
# DISCOVERY_RATE_LIMIT=60              # per-source politeness ceiling, requests/minute
# DISCOVERY_SOURCE_TIMEOUT=300         # seconds before a hung source is abandoned
# DISCOVERY_CONFIDENCE_THRESHOLD=0.45  # below this a candidate is kept for review, never promoted

# ─────────────────────────────────────────────────────────────────────────────
# 6c. WELLFOUND CONNECTOR (a Market Discovery source; OFF unless enabled)
#    A data source only: it crawls PUBLIC startup listings through the shared crawl
#    service and returns candidates. Every business decision — duplicates, confidence,
#    persistence — stays in the Market Discovery Engine.
#
#    Enable by naming it in DISCOVERY_SOURCES (see 6b). Registration alone does
#    nothing: crawling a third party is an explicit configuration decision.
#      DISCOVERY_SOURCES=wellfound
#
#    NOTE: wellfound.com serves company pages only to JavaScript-capable clients and
#    is behind bot protection. Without a JS-rendering crawl provider the connector
#    reports a clear "blocked" failure rather than silently returning nothing — and
#    the platform never attempts to work around bot detection.
# ─────────────────────────────────────────────────────────────────────────────
# WELLFOUND_BASE_URL=https://wellfound.com
# WELLFOUND_LISTING_PATHS=             # comma-separated; empty uses the public defaults
# WELLFOUND_LISTING_QUERY=             # opaque filter, e.g. "stage=seed"
# WELLFOUND_MAX_PAGES=3                # listing pages walked per run
# WELLFOUND_MAX_COMPANIES=50           # company detail pages per run — the expensive bound
# WELLFOUND_CRAWL_DEPTH=1
# WELLFOUND_FETCH_COMPANY_PAGES=true   # false = listing data only (cheap, shallow)
# WELLFOUND_INCREMENTAL=true           # skip companies already stored

# ─────────────────────────────────────────────────────────────────────────────
# 6d. NVIDIA INCEPTION CONNECTOR (a Market Discovery source; OFF unless enabled)
#    The first fully working discovery source. Enumerates NVIDIA's PUBLIC customer
#    stories via the locale sitemap and parses the server-rendered pages, all through
#    the shared crawl service. No credentials and no JS-rendering provider needed.
#
#    Enable by naming it in DISCOVERY_SOURCES (see 6b):
#      DISCOVERY_SOURCES=nvidia_inception
#
#    Pagination deliberately does NOT use ?page= — www.nvidia.com/robots.txt carries
#    "Disallow: /*[?&]page=*". The sitemap returns every case study in one request,
#    and each URL is re-checked against robots.txt before it is fetched.
# ─────────────────────────────────────────────────────────────────────────────
# NVIDIA_INCEPTION_BASE_URL=https://www.nvidia.com
# NVIDIA_INCEPTION_SITEMAP_PATH=/en-us/en-us.sitemap.xml
# NVIDIA_INCEPTION_USE_SITEMAP=true    # primary enumeration surface
# NVIDIA_INCEPTION_INDEX_PATHS=        # comma-separated; empty uses the public defaults
# NVIDIA_INCEPTION_MAX_PAGES=2         # index pages walked (secondary to the sitemap)
# NVIDIA_INCEPTION_MAX_COMPANIES=50    # case-study pages per run — the expensive bound
# NVIDIA_INCEPTION_CRAWL_DEPTH=1
# NVIDIA_INCEPTION_FETCH_COMPANY_PAGES=true   # false = enumeration only (cheap, thin)
# NVIDIA_INCEPTION_INCREMENTAL=true    # skip case studies already stored

# ─────────────────────────────────────────────────────────────────────────────
# 6e. MARKET INTELLIGENCE LAYER (on by default; no credentials, no network)
#    Turns discovery candidates into business intelligence: company classification,
#    technology detection, engineering / funding / strategic signals, an opportunity
#    priority (CRITICAL|HIGH|MEDIUM|LOW) and the explanation behind each.
#
#    DETERMINISTIC RULES ONLY — no machine learning, no LLM, no external AI service.
#    The same candidate and rule pack always produce the same record, which is what
#    makes a stored priority auditable months later.
#
#    Runs as the `market_intelligence` stage of every Standard Run, immediately
#    after market_discovery. With no candidates it is a successful no-op, so nothing
#    here needs setting to deploy safely.
#
#    Every business decision below is CONFIGURATION. The vocabulary lives in rule
#    packs, so changing what the platform looks for never means changing code.
# ─────────────────────────────────────────────────────────────────────────────
# INTELLIGENCE_ENABLED=true            # master switch for the whole layer
# INTELLIGENCE_RULE_PACK=semiconductor # built-in vocabulary pack
# INTELLIGENCE_RULES_PATH=             # JSON overlay: adds/replaces rules, thresholds, weights
#                                      # unreadable => falls back to the built-in pack, loudly
# INTELLIGENCE_DISABLED_RULES=         # comma-separated rule keys to switch off, e.g. quantum
# INTELLIGENCE_ENABLED_RULES=          # comma-separated rule keys to switch back on
# INTELLIGENCE_EXTRA_TERMS=            # JSON, e.g. {"asic": ["bespoke silicon"]}
# INTELLIGENCE_THRESHOLDS=             # JSON, e.g. {"technology_target": 4}
# INTELLIGENCE_WEIGHTS=                # JSON, e.g. {"funding_activity": 2}  (0 disables a factor)
# INTELLIGENCE_PRIORITY_CRITICAL=0.75  # band floors, checked most-urgent first
# INTELLIGENCE_PRIORITY_HIGH=0.55
# INTELLIGENCE_PRIORITY_MEDIUM=0.35
# INTELLIGENCE_SIGNAL_MIN_CONFIDENCE=0.3  # below this a signal is detected but not reported
# INTELLIGENCE_BATCH_SIZE=200          # candidates interpreted in one pass
# INTELLIGENCE_MAX_CANDIDATES=2000     # ceiling read per run (0 = no cap)
# INTELLIGENCE_CONCURRENCY=1           # evaluation is pure CPU; >1 is for future enrichment
# INTELLIGENCE_REPROCESS_ALL=false     # true = re-interpret everything (roll out a rule change)
# INTELLIGENCE_LOG_LEVEL=              # e.g. DEBUG, to see per-rule evaluation

# ─────────────────────────────────────────────────────────────────────────────
# 7. MACHINE LEARNING (optional; defaults work out of the box, no extra services)
#    Feature store + recommendation model. Embeddings use a deterministic zero-
#    dependency fallback by default; set the backend to sentence-transformers only
#    if you install it. None of this runs inside a scheduled pipeline. See ml/.
# ─────────────────────────────────────────────────────────────────────────────
# SP_ML_ENABLED=true
# SP_ML_EMBEDDING_BACKEND=hash         # hash (default) | sentence-transformers
# SP_ML_FEATURE_VERSION=fs-1
# SP_ML_PRIMARY_METRIC=pr_auc          # metric a promotion is judged on
# SP_ML_PROMOTE_MIN_ROC_AUC=0.60       # quality gates a candidate must clear to be promoted
# SP_ML_PROMOTE_MIN_PR_AUC=0.50
