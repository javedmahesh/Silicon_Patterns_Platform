# Base path for the API. In dev, the Vite server proxies /api -> http://127.0.0.1:8000
# (see vite.config.ts) so the default below "just works" against a local backend.
# In production, set this to your deployed API origin, e.g. https://api.example.com
VITE_API_BASE_URL=/api

# Only required when the backend sets SP_API_KEY. Sent as the X-API-Key header.
# Leave blank for local dev (auth is disabled when the backend has no SP_API_KEY).
VITE_API_KEY=

# Sign-in is Microsoft Entra ID (Azure AD) via MSAL (see src/lib/auth/msal.ts).
# REQUIRED in production — must match the backend's MICROSOFT_CLIENT_ID / _TENANT_ID
# and the Entra app's SPA redirect URI (your deployed frontend origin).
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=

# Dev bypass: opens the app without login as a synthetic admin. MUST be unset/false
# in production. The backend mirrors this with DEV_AUTH_BYPASS.
VITE_DEV_AUTH_BYPASS=

# NOTE: Outreach is now a NATIVE module (FastAPI + this SPA), not a separate app —
# there is no VITE_OUTREACH_URL / iframe anymore. It works out of the box.
