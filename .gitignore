# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Environment / secrets (keep .env.example)
.env
.env.*
!.env.example

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
# Intermediate OpenAPI dump (only src/lib/api/schema.ts is committed).
frontend/openapi.json

# Outreach (standalone Next.js app — also has its own nested .gitignore).
# .env / .env.*.local are already covered by the secrets block above (keeps .env.example).
outreach/node_modules/
outreach/.next/
outreach/out/
outreach/.vercel/

# OS / editor noise
.DS_Store
Thumbs.db

# Local runtime databases / artifacts — NOT shipped. Production uses the Supabase
# Postgres (DATABASE_URL); this local SQLite carries real company/decision-maker/user
# data (PII) and must not be pushed to the deployment repo. A fresh clone auto-creates
# an empty one; seed it locally with scripts/seed_master_db.py if needed.
master_local.db
master_local.db-wal
master_local.db-shm
*.db.bak
*.sqlite
*.sqlite3

# Test / tooling output
test_output.txt
full_test_output.txt
*_output.txt
